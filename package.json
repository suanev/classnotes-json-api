{
  "name": "classnotes-json-api",
  "private": true,
  "version": "1.0.0",
  "description": "JSON Server backend for ClassNotes demos and mobile testing",
  "scripts": {
    "start": "sh -c 'test -f /data/db.json || cp db.json /data/db.json; json-server /data/db.json --host 0.0.0.0 --port ${PORT:-3001}'",
    "start:local": "json-server db.json --host 0.0.0.0 --port 3001"
  },
  "dependencies": {
    "json-server": "^1.0.0-beta.15"
  }
}
